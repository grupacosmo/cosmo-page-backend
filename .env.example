# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
# spring-dotenv loads `.env` automatically at startup, so no shell exports are needed.
# Local (dev) runs fine with everything empty — see application-local.yml for defaults.

# ---- Local (dev) ----
# Nothing required. Postgres runs via `docker-compose up -d`.
# API key used by local requests (defaults to `local-dev-key`):
API_KEYS=

# ---- Prod ----
# Set the active profile with: -Dspring.profiles.active=prod
POSTGRES_URL=
POSTGRES_USERNAME=
POSTGRES_PASSWORD=

# When true (default in prod), requests without a valid `apiKey` header are rejected.
# Keep this true in production so the API fails closed.
API_KEYS_REQUIRED=true

# Comma-separated list of allowed CORS origins.
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://cosmopk.pl

# The only token that is truly required for the app to talk to Facebook.
FB_TOKEN=

# Page access token + page id used to fetch posts at startup, when no token
# is stored in the database yet (alternative to POST /api/facebook/token).
FB_PAGE_TOKEN=
FB_PAGE_ID=

CLIENT_ID=
CLIENT_SECRET=
PROD_URL=

# SMTP / mail (only needed if the mail feature is used)
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
