# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
# spring-dotenv loads `.env` automatically at startup, so no shell exports are needed.
# Local (dev) runs fine with everything empty — see application-local.yml for defaults.

# ---- Local (dev) ----
# Nothing required. Postgres runs via `docker-compose up -d`.
# No API key is required locally (application-local.yml sets api-keys-required=false):
API_KEYS=

# Host port for the Postgres service in docker-compose.yaml.
POSTGRES_HOST_PORT=5432

# ---- Prod ----
# Set the active profile with: -Dspring.profiles.active=prod
POSTGRES_URL=
POSTGRES_USERNAME=
POSTGRES_PASSWORD=

# When true (default in prod), requests without a valid `apiKey` header are rejected.
# If `true` is set with an empty API_KEYS the application fails to start (fail closed).
# The `local` profile overrides this to false.
API_KEYS_REQUIRED=true

# Comma-separated list of allowed CORS origins.
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://cosmopk.pl

# The only token that is truly required for the app to talk to Facebook.
FB_TOKEN=

# Page access token + page id used to fetch posts at startup, when no token
# is stored in the database yet (alternative to POST /api/facebook/token).
FB_PAGE_TOKEN=
FB_PAGE_ID=

CLIENT_ID=
CLIENT_SECRET=
PROD_URL=

# ---- Kubernetes crash-watcher (prod only) ----
# Messenger group thread id where the crash-watcher sends notifications about
# pod restarts (Graph API recipient.id, e.g. t_id_...). k8s-only; the
# crash-watcher CronJob will not start without this key in the cosmo-env Secret.
# How to find it: k8s/scripts/find-thread.sh (lists the Page's conversations).
MESSENGER_RECIPIENT_ID=
